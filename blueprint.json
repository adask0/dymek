{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/admin.php?page=dymek",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": {
		"username": "admin",
		"password": "password"
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_DISPLAY": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "plugin-check"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "dymek/dymek.php"
		}
	]
}

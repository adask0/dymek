#. Plugin Name of the plugin
#: dymek.php
msgid "Dymek – FAQ Chat"
msgstr "Dymek – czat FAQ"

#. Description of the plugin
#: dymek.php
msgid "A lightweight FAQ chat with ready-made answer paths. Runs entirely on your site: no account, no external services, no tracking."
msgstr "Lekki czat FAQ z gotowymi ścieżkami odpowiedzi. Działa w całości na Twojej stronie: bez konta, bez zewnętrznych usług, bez śledzenia."

#. Author of the plugin
#: dymek.php
msgid "Adam Trojecki"
msgstr "Adam Trojecki"

